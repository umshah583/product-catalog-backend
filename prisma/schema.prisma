// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Multi-tenant support
model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  products    Product[]
  categories  Category[]
  settings    Settings?
  promotionalOffers PromotionalOffer[]
  orders      Order[]
  deliveryNotes DeliveryNote[]
  creditApplications CreditApplication[]

  @@index([slug])
  @@index([isActive])
}

// Authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  role          UserRole  @default(USER)
  tenantId      String
  isActive      Boolean   @default(true)
  refreshToken String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tenantId])
  @@index([role])
}

enum UserRole {
  ADMIN
  USER
}

// Settings for dynamic company config
model Settings {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  companyName     String
  catalogTitle    String?
  whatsappNumber  String?
  phoneNumber     String?
  contactEmail    String?
  currency        String   @default("USD")
  currencySymbol  String   @default("$")
  address         String?
  workingHours    String?
  aboutCompany    String?
  whatsappEnabled Boolean  @default(false)
  logoUrl         String?
  bannerTitle     String?
  bannerSubtitle  String?
  bannerImageUrl  String?
  primaryColor    String?
  secondaryColor  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Categories
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  tenantId    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([sortOrder])
  @@index([isActive])
}

// Products
model Product {
  id              String           @id @default(cuid())
  name            String
  sku             String
  slug            String
  categoryId      String
  categoryName    String
  brand           String?
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  discountPrice   Decimal?         @db.Decimal(10, 2)
  currency        String           @default("USD")
  stockStatus     StockStatus      @default(IN_STOCK)
  images          String[]
  specifications  Json?
  featured        Boolean          @default(false)
  isActive        Boolean          @default(true)
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  promotionalOffers PromotionalOffer[]

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
  @@index([stockStatus])
  @@index([featured])
  @@index([isActive])
}

// Promotional Offers
model PromotionalOffer {
  id              String              @id @default(cuid())
  name            String
  description     String?
  offerType       OfferType
  buyQuantity     Int?                // For BUY_X_GET_Y_FREE offers
  getQuantity     Int?                // For BUY_X_GET_Y_FREE offers
  discountPercent Int?                // For PERCENTAGE_DISCOUNT offers
  discountAmount  Decimal?            @db.Decimal(10, 2) // For FLAT_DISCOUNT offers
  applicableTo    ApplicableTo        // ALL_PRODUCTS, SPECIFIC_CATEGORIES, SPECIFIC_PRODUCTS
  categoryIds     String[]            // For SPECIFIC_CATEGORIES
  productIds      String[]            // For SPECIFIC_PRODUCTS
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean             @default(true)
  priority        Int                 @default(0) // Higher priority offers applied first
  tenantId        String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products        Product[]

  @@index([tenantId])
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
  @@index([priority])
}

enum OfferType {
  BUY_X_GET_Y_FREE
  PERCENTAGE_DISCOUNT
  FLAT_DISCOUNT
}

enum ApplicableTo {
  ALL_PRODUCTS
  SPECIFIC_CATEGORIES
  SPECIFIC_PRODUCTS
}

// Customer Orders
model Order {
  id            String      @id @default(cuid())
  orderNumber   String
  customerName  String
  customerPhone String
  customerEmail String?
  customerAddress String?
  notes         String?
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal     @db.Decimal(10, 2)
  currency      String      @default("USD")
  itemCount     Int
  tenantId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         OrderItem[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  brand       String?
  sku         String?
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 2)

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Delivery Notes
model DeliveryNote {
  id              String             @id @default(cuid())
  dnNumber        String
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerTrn     String?
  billingAddress  String?
  shippingAddress String?
  notes           String?
  status          DeliveryNoteStatus @default(DRAFT)
  salesman        String?
  warehouse       String?
  driver          String?
  vehicleNumber   String?
  orderId         String?
  orderNumber     String?
  deliveryDate    DateTime?
  totalAmount     Decimal            @db.Decimal(10, 2)
  currency        String             @default("AED")
  itemCount       Int
  tenantId        String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           DeliveryNoteItem[]

  @@unique([tenantId, dnNumber])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model DeliveryNoteItem {
  id             String  @id @default(cuid())
  deliveryNoteId String
  productId      String?
  productName    String
  brand          String?
  sku            String?
  barcode        String?
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  lineTotal      Decimal @db.Decimal(10, 2)

  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
}

enum DeliveryNoteStatus {
  DRAFT
  PENDING
  DELIVERED
  CANCELLED
}

// Customer Credit Applications (AAF official form)
model CreditApplication {
  id              String   @id @default(cuid())
  appNumber       String
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerTrn     String?
  status          CreditAppStatus @default(DRAFT)
  formData        Json
  signatureData   String?  // data URL (png) or S3 key
  stampData       String?
  initials        String?
  pdfKey          String?  // generated PDF storage key
  internalNotes   String?
  reviewedBy      String?
  reviewedAt      DateTime?
  submittedAt     DateTime?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents       CreditAppDocument[]
  audits          CreditAppAudit[]

  @@unique([tenantId, appNumber])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model CreditAppDocument {
  id            String   @id @default(cuid())
  applicationId String
  docType       String
  fileName      String
  fileUrl       String
  fileKey       String
  received      Boolean  @default(false)
  remarks       String?
  createdAt     DateTime @default(now())

  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model CreditAppAudit {
  id            String   @id @default(cuid())
  applicationId String
  action        String
  detail        String?
  actor         String?
  createdAt     DateTime @default(now())

  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

enum CreditAppStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}
